# Gradle
.gradle/
build/
!gradle/wrapper/gradle-wrapper.jar

# Per-developer, and carries the SDK path and API hosts
local.properties

# IDE
.idea/
*.iml
.kotlin/

# Kotlin/Native
.konan/

# macOS
.DS_Store

# Xcode
xcuserdata/
*.xcuserstate
iosApp/Pods/
iosApp/build/
iosApp/*.xcworkspace/xcuserdata/
iosApp/*.xcodeproj/xcuserdata/
iosApp/*.xcodeproj/project.xcworkspace/xcuserdata/
# Per-developer BASE_URL override for running on a physical iPhone
iosApp/Configuration/Local.private.xcconfig
# The iOS Maps API key, written from local.properties by `./gradlew :composeApp:writeIosMapsKey` (M4-M2)
iosApp/Configuration/Maps.private.xcconfig
# Google Sign-In client ids for iOS (M3-M0), one file per environment since M3-M19a.
iosApp/Configuration/SignIn.private.xcconfig
iosApp/Configuration/SignIn.*.private.xcconfig

# Secrets — never commit any of these. The Firebase files go in androidApp/src/<flavor>/ and
# iosApp/Firebase/<environment>/ (docs/setup-signin-push.md); their committed `.example` siblings are placeholders.
google-services.json
GoogleService-Info.plist
service-accounts/
*.keystore
*.jks
.env
