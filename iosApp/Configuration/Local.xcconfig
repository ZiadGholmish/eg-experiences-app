#include "Config.xcconfig"

// `$()` breaks up the `//`, which xcconfig would otherwise read as a comment.
// The simulator shares the host's network stack, so localhost reaches the api
// deployable directly. NOT 10.0.2.2 — that alias only means something to the
// Android emulator.
BASE_URL = http:/$()/localhost:8084/api/v1/

// A physical iPhone cannot reach the Mac's localhost. Override BASE_URL with
// the Mac's LAN address in `Local.private.xcconfig`, which is gitignored — the
// iOS counterpart of LOCAL_BASE_URL in local.properties. See
// Local.private.xcconfig.example. The `?` makes the include optional, so the
// simulator still builds without one.
#include? "Local.private.xcconfig"

// Share-link host for the parser. Matches the api's local default (SITE_PUBLIC_BASE_URL =
// http://localhost:8084). No Associated Domains entitlement here (CODE_SIGN_ENTITLEMENTS unset):
// Universal Links need a public https host, so applinks:localhost could never verify, and the
// capability needs a paid team in the provisioning profile, which would stop a device build signed
// by a personal team. See README → Deep links.
APP_LINK_HOST = localhost

PRODUCT_BUNDLE_IDENTIFIER = eg.bahr.app.local
DISPLAY_NAME = Bahr Local
