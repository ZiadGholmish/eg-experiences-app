// Shared by every build configuration. The per-environment files include this
// one and add BASE_URL, mirroring composeApp's local/dev/prod product flavors.

// Keep PRODUCT_NAME free of spaces — it names the executable and the .app.
// The launcher label is DISPLAY_NAME, via CFBundleDisplayName in Info.plist.
PRODUCT_NAME = Bahr
DISPLAY_NAME = Bahr
PRODUCT_BUNDLE_IDENTIFIER = eg.bahr.app

CURRENT_PROJECT_VERSION = 1
// The same version name as Android's versionName (user decision 2026-10-11).
MARKETING_VERSION = 0.1

// Google Maps for iOS (M4-M2). Empty by default, so a checkout without a key still builds (the map
// then shows its pins on a plain ground). The real key lives in the gitignored Maps.private.xcconfig,
// written from local.properties (MAPS_API_KEY_IOS) by `./gradlew :composeApp:writeIosMapsKey`; see
// Maps.private.xcconfig.example. The `?` makes the include optional.
MAPS_API_KEY_IOS =
#include? "Maps.private.xcconfig"

// Sign-in (M3-M0). Google Sign-In for iOS reads GIDClientID from Info.plist; its URL scheme is the reversed
// client id. Both empty by default: the app then offers Apple only (and Apple needs the Sign in with Apple
// capability, see iosApp.entitlements). Real values go in the gitignored SignIn.private.xcconfig (see its
// .example). FAKE_SIGN_IN is set by Local.xcconfig only (see there); the app ignores it in Release builds.
GOOGLE_IOS_CLIENT_ID =
GOOGLE_IOS_REVERSED_CLIENT_ID =
#include? "SignIn.private.xcconfig"
