#include "Config.xcconfig"

// The Firebase file folder (iosApp/Firebase/<APP_ENVIRONMENT>/), M3-M19a.
APP_ENVIRONMENT = prod

// Placeholder until a prod host is deployed — matches composeApp's `prod` flavor.
BASE_URL = https:/$()/api.example.invalid/api/v1/

// Universal Links: https://bahr.eg/t/{slug} (PLAN §6). The entitlement reads APP_LINK_HOST too.
APP_LINK_HOST = bahr.eg
CODE_SIGN_ENTITLEMENTS = iosApp/iosApp.entitlements

// Google Sign-In client ids for eg.bahr.app, gitignored (see SignIn.private.xcconfig.example).
#include? "SignIn.prod.private.xcconfig"
