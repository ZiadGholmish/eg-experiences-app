# Copy to `local.properties` (gitignored) and adjust. The SDK path is written by
# Android Studio on first open; the rest are per-developer overrides.
sdk.dir=/Users/<you>/Library/Android/sdk

# Base URL for the `local` product flavor. 10.0.2.2 is the host machine as seen
# from the Android emulator; the api deployable listens on 8084.
# Plain HTTP is allowed only to 10.0.2.2, localhost and 127.0.0.1 (plus LOCAL_LAN_HOST below), and only
# in the localDebug build (generated from androidApp/src/localDebug/network_security_config.xml).
# A physical device: set LOCAL_LAN_HOST to the Mac's LAN address and either point this at it, or use
# `adb reverse tcp:8084 tcp:8084` with LOCAL_BASE_URL=http://localhost:8084/api/v1/.
# `localRelease` therefore cannot reach a local HTTP backend: release builds never allow plain
# HTTP. If a local release build is ever needed (e.g. to check R8), put the backend behind HTTPS.
LOCAL_BASE_URL=http://10.0.2.2:8084/api/v1/

# The Mac's LAN address (`ipconfig getifaddr en0`; a bare IP or hostname, no scheme or port), allowed plain
# HTTP in the localDebug build. Needed on a physical phone when the local api serves its photo URLs on that
# address (ASSET_BASE_URL, as a physical iPhone needs): without it the phone shows only the blurred
# placeholders. Unset, the build is unchanged. DHCP-assigned, so personal: keep it here, never in git.
# LOCAL_LAN_HOST=192.168.1.20

# Share-link host the `local` flavor claims with App Links (https://<host>/t/{slug}; http too, in local
# only). `localhost` matches the api's default SITE_PUBLIC_BASE_URL, so its "Open in app" link opens
# this app. To check App Links verification, set it to an https tunnel's host — README → Deep links.
LOCAL_APP_LINK_HOST=localhost

# Google Maps (M4-M2): one key per platform, each restricted in the Google Cloud console (Android:
# package eg.bahr.app[.local|.dev] + the signing SHA-1; iOS: bundle id eg.bahr.app[.local|.dev]).
# Never commit them. Android reads MAPS_API_KEY_ANDROID into the manifest at build time; for iOS run
# `./gradlew :composeApp:writeIosMapsKey` once (the Xcode build also runs it), which writes
# MAPS_API_KEY_IOS into the gitignored iosApp/Configuration/Maps.private.xcconfig. Without a key the
# app still builds and the map screen shows its pins on a plain ground.
MAPS_API_KEY_ANDROID=
MAPS_API_KEY_IOS=

# Sign in with Google on Android (M3-M0; one per flavor since M3-M19a): the Google "web" (server) OAuth client id
# of that environment's Google Cloud project, the one Credential Manager puts in the ID token's `aud`; the backend
# lists the same value in AUTH_GOOGLE_CLIENT_IDS. The Android OAuth client (package + your signing SHA-1) must also
# exist in the same project. Empty: the `local` flavor signs in with fake tokens (the local api's fake verifier),
# the other flavors offer no sign-in. Setting GOOGLE_SERVER_CLIENT_ID_LOCAL switches the local build to real
# Google sign-in (run the local api with AUTH_VERIFICATION=jwks then). The local clients live in the dev project,
# so _LOCAL and _DEV are usually the same web client id. iOS's Google client ids go in
# iosApp/Configuration/SignIn.<env>.private.xcconfig instead. Checklist: docs/setup-signin-push.md.
GOOGLE_SERVER_CLIENT_ID_LOCAL=
GOOGLE_SERVER_CLIENT_ID_DEV=
GOOGLE_SERVER_CLIENT_ID_PROD=

# Push (Firebase, M3-M5) needs no setting here: drop the environment's google-services.json into
# androidApp/src/<flavor>/ (local, dev or prod; gitignored). Without it the app builds with push off.

# Checkout (M3-M1): the link the hosted checkout returns the browser to on the local flavor. Empty (the default)
# sends none. To try the return, set it to the local app's own scheme, which the local api's
# PAYMENT_RETURN_URL_PREFIXES lists by default (http://localhost:8084,eg.bahr.app.local://checkout):
#   LOCAL_PAYMENT_RETURN_URL=eg.bahr.app.local://checkout
LOCAL_PAYMENT_RETURN_URL=
