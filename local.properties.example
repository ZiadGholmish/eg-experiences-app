# Copy to `local.properties` (gitignored) and adjust. The SDK path is written by
# Android Studio on first open; the rest are per-developer overrides.
sdk.dir=/Users/<you>/Library/Android/sdk

# Base URL for the `local` product flavor. 10.0.2.2 is the host machine as seen
# from the Android emulator; the api deployable listens on 8084.
# Plain HTTP is allowed only to 10.0.2.2, localhost and 127.0.0.1, and only in the
# localDebug build (composeApp/src/androidLocalDebug/res/xml/network_security_config.xml).
# A physical device on a LAN IP needs that IP added there, or `adb reverse tcp:8084 tcp:8084`
# with LOCAL_BASE_URL=http://localhost:8084/api/v1/.
# `localRelease` therefore cannot reach a local HTTP backend: release builds never allow plain
# HTTP. If a local release build is ever needed (e.g. to check R8), copy that file to
# composeApp/src/androidLocal/res/xml/ for the run, or put the backend behind HTTPS.
LOCAL_BASE_URL=http://10.0.2.2:8084/api/v1/
