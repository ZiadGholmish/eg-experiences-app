<resources>
    <!-- English. `values/` is the fallback bundle; `values-ar/` is what most
         users actually see, since Arabic is the default locale. -->
    <string name="app_name">Bahr</string>

    <!-- Trips -->
    <string name="trips_title">Trips</string>
    <string name="trips_empty">No trips yet. Check back soon.</string>
    <!-- Home (M4-M1a): the heading over the full list when server-driven sections sit above it. -->
    <string name="trips_all_title">All trips</string>
    <!-- M4-M1b: a Home row's link to its whole list, and the trip count over a category or "See all" list. -->
    <string name="trips_see_all">See all</string>
    <plurals name="trips_count">
        <item quantity="one">%1$d trip</item>
        <item quantity="other">%1$d trips</item>
    </plurals>
    <!-- M4-M1b: a category page with a filter chip on that nothing matches. -->
    <string name="trips_filter_empty">No trips match this filter. Try another one.</string>
    <!-- Search (M4-M3): Home's search entry and the field's placeholder (the prototype's searchPh, minus
         "dates": the server does not search dates), the field's clear button, recent searches, the
         hint before anything is typed, and a search nothing matches (%1$s is the text as typed; the
         server matches word by word, every word somewhere in the trip). -->
    <string name="search_hint">Search trips, places, hosts</string>
    <string name="search_clear">Clear search</string>
    <string name="search_recent_title">Recent searches</string>
    <string name="search_recent_clear">Clear all</string>
    <string name="search_start">Type at least two letters: a trip, a place, a kind of trip or a host. Arabic or English both work.</string>
    <string name="search_no_results">No trip matches all of “%1$s”. Try fewer or different words.</string>
    <!-- Home's app bar (M4-M1): the wordmark next to the logo tile. The handoff draws it in Latin
         letters in both languages: it is the brand's mark, not a word to translate. -->
    <string name="home_wordmark">bahr</string>
    <!-- Home's banner carousel (M4-M1): what a screen reader says for one of the dots under it, each
         of which jumps to its slide. %1$d is the slide's number, %2$d how many there are. -->
    <string name="home_slide_of">Slide %1$d of %2$d</string>
    <!-- A hero slide's white price pill (M4-M7): the server's "from" price, the cheapest of what the
         slide leads to. %1$s is the formatted amount with its currency, e.g. "450 EGP". -->
    <string name="home_banner_price_from">From %1$s</string>
    <!-- Multi-day trips (M4-B0b): the badge on a card with nights > 0. -->
    <plurals name="trip_nights_badge">
        <item quantity="one">%1$d night</item>
        <item quantity="other">%1$d nights</item>
    </plurals>
    <!-- The facts grid's duration cell on a multi-day trip ("One day" is for day trips). -->
    <string name="trip_fact_duration">Trip length</string>
    <!-- Under a date card's day when the trip is back on a later day. -->
    <string name="departure_back_on">Back %1$s</string>
    <!-- A multi-day booking's dates: leaves, then the day it is back. -->
    <string name="booking_dates_overnight">%1$s to %2$s</string>
    <string name="trip_per_person">per person</string>
    <string name="trip_duration_hours">%1$s hrs</string>
    <string name="trip_whats_included">What’s included</string>
    <string name="trip_itinerary">The day, in order</string>
    <string name="trip_host_knowledge">Good to know</string>
    <string name="trip_what_to_bring">What to bring</string>
    <string name="trip_best_time">Best time of year</string>
    <string name="trip_look_out_for">What to look out for</string>
    <string name="trip_what_to_know">What to know</string>
    <string name="trip_meeting_point">Meeting point</string>
    <string name="trip_departure_point">Departure point</string>
    <string name="trip_host_verified">Verified host</string>

    <!-- Trip page (handoff screen 3). `%1$s · %2$s` pairs reuse format_pair. -->
    <string name="trip_reviews">Reviews</string>
    <string name="trip_photo_counter">%1$d / %2$d</string>
    <string name="trip_fact_price">Price</string>
    <string name="trip_fact_price_note">per person, all in</string>
    <string name="trip_fact_day">One day</string>
    <string name="trip_fact_bus">Bus leaves</string>
    <string name="trip_fact_bus_be_there">be there %1$s</string>
    <string name="trip_fact_place">Trip is at</string>
    <string name="trip_fact_distance">%1$d km</string>
    <string name="trip_day_note">Times marked ≈ are approximate.</string>
    <string name="trip_time_approximate">≈%1$s</string>
    <string name="trip_sold_out_title">%1$s is full</string>
    <string name="trip_sold_out_body">All %1$d seats are booked.</string>
    <string name="trip_sold_out_alternative">%1$s has %2$s left.</string>
    <string name="trip_sold_out_alternative_same_price">%1$s has %2$s left, same price.</string>
    <string name="trip_waitlist_join">Join the waiting list</string>
    <string name="trip_waitlist_form_note">Leave your email. If a place opens up on this date, we’ll let you know.</string>
    <string name="trip_waitlist_email">Email</string>
    <string name="trip_waitlist_email_invalid">Enter a valid email address.</string>
    <string name="trip_waitlist_submit">Add me to the list</string>
    <!-- The form's party stepper. Its own keys (M3-M0, M2-M3 review #6), so a booking copy change
         cannot change the trip page; the wording matches date + party's today. -->
    <string name="trip_waitlist_party_size">How many people</string>
    <string name="trip_waitlist_party_decrease">Fewer people</string>
    <string name="trip_waitlist_party_increase">More people</string>
    <plurals name="trip_waitlist_party_count">
        <item quantity="one">%1$d person</item>
        <item quantity="other">%1$d people</item>
    </plurals>
    <string name="trip_waitlist_joined_title">You’re on the waiting list</string>
    <string name="trip_waitlist_joined_body">If a place opens up on %1$s, we’ll email you at %2$s.</string>
    <string name="trip_waitlist_full">The waiting list for this date is full.</string>
    <string name="trip_waitlist_seats_opened">Seats just opened up on %1$s. You can book it now.</string>
    <string name="trip_waitlist_date_closed">%1$s can’t be booked any more. Pick another date.</string>
    <string name="trip_dates_empty">No dates are open yet.</string>
    <string name="trip_policy_cancellation">Free cancellation up to %1$d hours before departure.</string>
    <string name="trip_policy_units">Prices in EGP, times Cairo (24h).</string>
    <string name="trip_bar_per_person">Per person</string>
    <string name="trip_cta_choose_date">Choose a date</string>
    <string name="trip_cta_continue">Continue</string>
    <string name="trip_cta_sold_out">Sold out</string>
    <string name="action_back">Back</string>
    <plurals name="trip_hours_door_to_door">
        <item quantity="one">%1$d hour door to door</item>
        <item quantity="other">%1$d hours door to door</item>
    </plurals>
    <plurals name="trip_host_trips_run">
        <item quantity="one">%1$d trip run</item>
        <item quantity="other">%1$d trips run</item>
    </plurals>

    <!-- Host page (M4-M10), opened from the trip page's host card. The handoff has no host page. -->
    <string name="host_open">Open the host’s page</string>
    <string name="host_kind_person">Host</string>
    <string name="host_kind_company">Host company</string>
    <string name="host_member_since">Member since %1$s</string>
    <string name="host_no_reviews">No reviews yet.</string>
    <string name="host_rating_average">Rated %1$s out of 5</string>
    <string name="host_trips_heading">Trips by %1$s</string>
    <string name="host_trips_empty">No trips from this host right now.</string>
    <!-- 404 on the host or their trips: unknown, or not approved (pending, suspended). -->
    <string name="host_not_available">This host isn’t available right now.</string>
    <plurals name="host_reviews_count">
        <item quantity="one">%1$d review</item>
        <item quantity="other">%1$d reviews</item>
    </plurals>
    <!-- A rating bar, read out: the stars, then how many reviews gave that many. -->
    <plurals name="host_rating_bar">
        <item quantity="one">%1$d star: %2$d</item>
        <item quantity="other">%1$d stars: %2$d</item>
    </plurals>

    <!-- "See all reviews" (M4-M11): every review of a trip or a host, opened under the review previews. -->
    <string name="reviews_see_all">See all reviews</string>
    <string name="reviews_sort_newest">Most recent</string>
    <string name="reviews_sort_highest">Highest rated</string>
    <string name="reviews_sort_lowest">Lowest rated</string>
    <!-- The host's reviews: the Trip filter's first chip, every one of the host's trips. -->
    <string name="reviews_all_trips">All trips</string>
    <string name="reviews_filter_empty">No reviews match this filter.</string>
    <!-- 404 on the reviews list: the trip is not published, or the host is unknown or not approved. -->
    <string name="reviews_not_available">These reviews aren’t available right now.</string>

    <!-- Departures -->
    <string name="departures_pick_a_date">Pick a date</string>
    <plurals name="departure_seats_left">
        <item quantity="one">%1$d seat left</item>
        <item quantity="other">%1$d seats left</item>
    </plurals>
    <plurals name="seat_count">
        <item quantity="one">%1$d seat</item>
        <item quantity="other">%1$d seats</item>
    </plurals>
    <string name="departure_closed">Booking closed</string>
    <string name="departure_cancelled">Cancelled</string>
    <string name="departure_sold_out">Sold out</string>
    <!-- M4-M5: a sold-out date this device is on the waiting list of: its date card and its trip card tag. -->
    <string name="waitlist_tag">Waiting list</string>

    <!-- Formats. Day and month names are the date's words only; BahrFormat puts them in order
         (weekday, day, month[, year]), which is the same in both languages. -->
    <string name="format_pair">%1$s · %2$s</string>
    <string name="format_rating_count">%1$s (%2$d)</string>
    <string-array name="weekdays_short">
        <item>Mon</item>
        <item>Tue</item>
        <item>Wed</item>
        <item>Thu</item>
        <item>Fri</item>
        <item>Sat</item>
        <item>Sun</item>
    </string-array>
    <string-array name="months_short">
        <item>Jan</item>
        <item>Feb</item>
        <item>Mar</item>
        <item>Apr</item>
        <item>May</item>
        <item>Jun</item>
        <item>Jul</item>
        <item>Aug</item>
        <item>Sep</item>
        <item>Oct</item>
        <item>Nov</item>
        <item>Dec</item>
    </string-array>

    <!-- Booking -->
    <string name="booking_party_size">How many people</string>
    <string name="booking_guest_name">Full name</string>
    <string name="booking_guest_phone">Mobile number</string>
    <string name="booking_continue">Continue</string>
    <string name="booking_hold_label">Seats held for</string>
    <string name="booking_confirm">Confirm booking</string>
    <string name="booking_total">Total</string>
    <string name="booking_your_ref">Your reference</string>
    <string name="booking_confirmed">You’re booked</string>
    <string name="booking_cancel">Cancel booking</string>

    <!-- Date + party (HANDOFF screen 4). Copy from the prototype; D1: no child fare, so no child note. -->
    <string name="booking_step_title">Date and party</string>
    <string name="booking_step_of">Step %1$d of %2$d</string>
    <string name="booking_price_per_person">%1$s per person</string>
    <plurals name="booking_party_max">
        <item quantity="one">Maximum %1$d person per booking.</item>
        <item quantity="other">Maximum %1$d people per booking.</item>
    </plurals>
    <plurals name="booking_party_count">
        <item quantity="one">%1$d person</item>
        <item quantity="other">%1$d people</item>
    </plurals>
    <string name="booking_party_decrease">Fewer people</string>
    <string name="booking_party_increase">More people</string>
    <string name="booking_guest_title">Your details</string>
    <string name="booking_guest_phone_invalid">Enter a valid mobile number.</string>
    <string name="booking_summary_price">Price per person</string>
    <string name="booking_summary_party">People</string>
    <string name="booking_summary_total_note">Your total is confirmed when the seats are held, before you pay.</string>
    <string name="booking_hold_cta">Hold seats and pay</string>
    <!-- No length in the copy: the hold's length is server policy, and nothing is held yet to read it from. -->
    <string name="booking_hold_note">Seats are held for a few minutes while you pay. Nothing is charged until you confirm.</string>
    <plurals name="booking_seats_left_cap">
        <item quantity="one">Only %1$d seat left on this date.</item>
        <item quantity="other">Only %1$d seats left on this date.</item>
    </plurals>

    <!-- Held seats (HANDOFF screen 5, "Payment", step 2 of 3). Payment itself is M3. -->
    <string name="booking_pay_step_title">Payment</string>
    <!-- Spoken once a minute by screen readers, never every second. -->
    <plurals name="booking_hold_minutes_left">
        <item quantity="one">%1$d minute left to pay</item>
        <item quantity="other">%1$d minutes left to pay</item>
    </plurals>
    <string name="booking_hold_already_held">You already have seats on hold. Finish this booking, or go back to release them first.</string>
    <string name="booking_hold_time_up">Time is up</string>
    <string name="booking_hold_checking">Checking your seats…</string>
    <string name="booking_hold_check_failed">Couldn’t check your seats. Trying again…</string>
    <!-- Home's card for a live hold (M2-M4). -->
    <string name="booking_continue_title">Continue your booking</string>
    <string name="booking_departs_from">Departs %1$s, %2$s, %3$s</string>
    <string name="booking_departs_at">Departs %1$s, %2$s</string>
    <string name="booking_pay_cta">Pay %1$s</string>
    <string name="booking_pay_coming">Paying in the app arrives in the next update. Your seats stay held until the timer ends.</string>
    <string name="booking_leave_title">Leave and release your seats?</string>
    <string name="booking_leave_body">Someone else can book them straight away.</string>
    <string name="booking_leave_confirm">Release seats</string>
    <string name="booking_leave_stay">Keep my seats</string>
    <string name="booking_leave_failed">We couldn’t release your seats. They are freed on their own when the timer ends.</string>
    <string name="booking_leave_anyway">Leave anyway</string>

    <!-- Map (M4-M2, handoff screen 2; the prototype's mapBtn, listBtn, mapTitle, mapNote). Home's way in,
         the screen's title and its way back to the list, the card a tapped pin opens, and the note under
         the map. The prototype's toggles over the map ("Show the drive", with its bus marker and notes,
         and "All trips") were removed (user decision 2026-10-12). -->
    <string name="map_open">Map</string>
    <string name="map_title">Where the trips are</string>
    <string name="map_list">List</string>
    <string name="map_card_bus_time">Bus leaves at %1$s</string>
    <string name="map_view_trip">View trip</string>
    <string name="map_card_close">Close</string>
    <string name="map_empty">No trips on the map yet. Check back soon.</string>

    <!-- The bottom bar (M4-M8): one label per tab. The iOS tab bar reads the same strings (handed to Swift by
         the shared code), so these are the only copies. -->
    <string name="tab_home">Home</string>
    <string name="tab_search">Search</string>
    <string name="tab_map">Map</string>
    <string name="tab_settings">Settings</string>

    <!-- Settings (M4-M8). The language names are each written in their own language (the prototype's
         langBtn), so a reader finds theirs whatever the app is showing. -->
    <string name="settings_title">Settings</string>
    <string name="settings_language">Language</string>
    <string name="settings_language_arabic">العربية</string>
    <string name="settings_language_english">English</string>
    <string name="settings_about_line">Bahr books trips around Egypt with real seats and real departure times. Trip pages and prices come in the language you pick here.</string>
    <!-- The version as the build names it (e.g. 0.1), kept left to right inside Arabic. -->
    <string name="settings_version">Version %1$s</string>

    <!-- Errors -->
    <string name="error_network">No connection. Check your internet and try again.</string>
    <string name="error_timeout">That took too long. Try again.</string>
    <string name="error_generic">Something went wrong. Try again.</string>
    <string name="error_hold_expired">Your seats were released. Pick a date again.</string>
    <string name="error_no_seats_available">Those seats just went. Try a different date.</string>
    <string name="error_departure_not_open">Booking just closed for this date. Pick another one.</string>
    <string name="error_validation">Check your details and try again.</string>
    <string name="error_rate_limited">Too many tries. Wait a minute and try again.</string>
