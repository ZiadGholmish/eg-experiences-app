    <string name="auth_profile_title">A few details</string>
    <string name="auth_profile_body">Your host uses these to reach you on the day. You can change them later.</string>
    <string name="auth_profile_name">Full name</string>
    <string name="auth_profile_phone">Mobile number</string>
    <string name="auth_profile_phone_invalid">Enter a valid mobile number.</string>
    <string name="auth_profile_save">Save</string>
    <string name="auth_profile_later">Later</string>
    <string name="auth_delete_title">Delete your account?</string>
    <string name="auth_delete_body">Your account, your sign-in and your waiting lists are removed. Bookings are kept for our records, without your name or number. This can’t be undone.</string>
    <string name="auth_delete_confirm">Delete account</string>
    <string name="auth_delete_cancel">Keep my account</string>
    <string name="auth_delete_host">This account is also a host’s. Contact us to remove it.</string>

