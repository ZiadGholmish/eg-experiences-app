    <string name="auth_body">Sign in to see your trips and to pay for a booking. Browsing, holding seats and waiting lists work without an account.</string>
    <string name="auth_continue_apple">Continue with Apple</string>
    <string name="auth_continue_google">Continue with Google</string>
    <string name="auth_unavailable">Sign-in isn’t set up in this build.</string>
    <string name="auth_close">Close</string>
