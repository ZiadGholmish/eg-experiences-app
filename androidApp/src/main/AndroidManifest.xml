<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ asks before an app shows notifications (M3-M5): only after the push pre-prompt's "Yes" (after a
         waiting-list join, or a hold just placed for its reminder, M3-M7). -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- enableOnBackInvokedCallback (M3-M12): predictive back on Android 13-15 too (16 has it by default at
         targetSdk 36), so a back swipe scrubs the NavHost's pop transition and shows the screen underneath. -->
    <application
        android:name=".EgApplication"
        android:allowBackup="true"
        android:enableOnBackInvokedCallback="true"
        android:icon="@android:drawable/sym_def_app_icon"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/Theme.AppCompat.DayNight.NoActionBar">

        <!-- Google Maps (M4-M2): filled at build time from MAPS_API_KEY_ANDROID in the gitignored
             local.properties (androidApp/build.gradle.kts); never written here. Empty in a build
             without one, and the map screen then draws its pins on a plain ground. -->
        <meta-data
            android:name="com.google.android.geo.API_KEY"
            android:value="${mapsApiKey}" />

        <!-- Push (M3-M5): pushes the system shows in the background land on the app's default channel (with sound),
             which EgApplication creates under this id. -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_channel_id"
            android:value="@string/push_channel_id" />
        <!-- ...with the monochrome small icon (M3-M5 review #3), not the launcher icon (a white blob there). -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_stat_bahr" />

        <!-- FCM's token and foreground pushes. Inert in a build without google-services.json (no FirebaseApp). -->
        <service
            android:name=".PushService"
            android:exported="false">
            <intent-filter>
                <action android:name="com.google.firebase.MESSAGING_EVENT" />
            </intent-filter>
        </service>

        <!-- The hold reminder's alarm (M3-M7): AlarmManager wakes it, only this app may (not exported). No
             exact-alarm permission: the alarm is inexact (setAndAllowWhileIdle). -->
        <receiver
            android:name=".HoldReminderReceiver"
            android:exported="false" />

        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|layoutDirection|uiMode"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <!-- singleTask: a link tapped while the app runs reaches this instance through onNewIntent,
                 instead of stacking a second activity with its own NavHost on top of the first. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

            <!-- Android App Links: the trip share link https://<host>/t/{slug} (PLAN §6). The host is
                 per flavor (androidApp/build.gradle.kts → appLinks); the backend proves this app owns
                 it with /.well-known/assetlinks.json. No android:port, so any port matches (the local
                 api is on 8084). appLinkLocalScheme is http for the local flavor only, https otherwise.
                 /b/{ref} is not claimed until the confirmation screen opens from a link. -->
            <intent-filter android:autoVerify="true">
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="https" />
                <data android:scheme="${appLinkLocalScheme}" />
                <!-- tools:ignore: lint reads the unmerged placeholder as the host and reports
                     AppLinkUrlError; the real host is filled per flavor at manifest merge. -->
                <data
                    android:host="${appLinkHost}"
                    tools:ignore="AppLinkUrlError" />
                <data android:pathPrefix="/t/" />
            </intent-filter>

            <!-- The hosted checkout's return link (M3-M1): <application id>://checkout/{ref}, the flavor's
                 PAYMENT_RETURN_URL. It only brings this (singleTask) activity forward, which clears the Custom
                 Tab above it; the held seats then read the booking. The shared onDeepLink ignores it. -->
            <intent-filter>
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data
                    android:host="checkout"
                    android:scheme="${applicationId}" />
            </intent-filter>
        </activity>
    </application>
</manifest>
