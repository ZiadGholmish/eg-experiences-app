<?xml version="1.0" encoding="utf-8"?>
<!--
  Every variant: no plain HTTP. The localDebug build replaces this file
  (src/androidLocalDebug/res/xml/network_security_config.xml) to reach a backend on the developer's machine.
  localRelease included: a release build never allows plain HTTP, so it cannot reach a local HTTP backend.
  A resource override rather than a localDebug manifest overlay: with the KMP Android source-set layout
  the variant manifest was not merged, while variant resources are.
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false" />
</network-security-config>
